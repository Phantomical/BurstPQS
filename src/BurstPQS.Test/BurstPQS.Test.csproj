<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Description>BurstPQS unit tests for BurstMapSO</Description>

    <!-- This project uses KSP's in-game test framework, not a standard .NET test runner -->
    <IsTestProject>false</IsTestProject>

    <KSPBT_ModRoot>$(ProjectRootDir)\GameData\BurstPQS.Test</KSPBT_ModRoot>
    <KSPBT_ModPluginFolder>Plugins</KSPBT_ModPluginFolder>

    <!-- IgnoresAccessChecksToAttribute from Krafs.Publicizer conflicts with the one
         in BurstPQS (visible via InternalsVisibleTo). Both projects need their own copy. -->
    <NoWarn>$(NoWarn);CS0436</NoWarn>

    <!-- Nothing we can do about this warning -->
    <ResolveAssemblyWarnOrErrorOnTargetArchitectureMismatch>None</ResolveAssemblyWarnOrErrorOnTargetArchitectureMismatch>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\BurstPQS\BurstPQS.csproj">
      <Private>false</Private>
      <KSPAssemblyName>BurstPQS</KSPAssemblyName>
      <KSPAssemblyVersion>$(Version)</KSPAssemblyVersion>
      <GenerateDependencyAttribute>true</GenerateDependencyAttribute>
    </ProjectReference>

    <PackageReference Include="KSP1Retooled.BuildTools" Version="2.0.1" />
    <PackageReference Include="Krafs.Publicizer" Version="2.3.0">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>

    <Reference Include="KSPBurst">
      <HintPath>$(DepSet1)/000_KSPBurst/Plugins/KSPBurst.dll</HintPath>
      <Private>false</Private>
      <KSPAssemblyName>KSPBurst</KSPAssemblyName>
      <KSPAssemblyVersion>1.5.5</KSPAssemblyVersion>
      <GenerateDependencyAttribute>true</GenerateDependencyAttribute>
    </Reference>

    <Reference Include="$(DepSet1)/000_KSPBurst/Plugins/Unity.*.dll" Condition=" '$(KSPBT_TargetGame)' != 'Retooled' ">
      <Private>false</Private>
    </Reference>
    <Reference Include="$(KSPBT_ManagedPath)/System.Runtime.CompilerServices.Unsafe.dll" Condition=" '$(KSPBT_TargetGame)' == 'Retooled' ">
      <Private>false</Private>
    </Reference>
    <Reference Include="$(DepSet1)/000_KSPBurst/Plugins/System.Runtime.CompilerServices.Unsafe.dll" Condition=" '$(KSPBT_TargetGame)' != 'Retooled' ">
      <Private>false</Private>
    </Reference>

    <Reference Include="KSPTextureLoader">
      <HintPath>$(DepSet1)/KSPTextureLoader/Plugins/KSPTextureLoader.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <Publicize Include="Assembly-CSharp" />
  </ItemGroup>
</Project>
